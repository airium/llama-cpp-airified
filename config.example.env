# Copy to config.env for host overrides; explicit values here override the environment.
PROFILE=tp-q8kv-262144-q8draft-sharedhead-gpuvision-u1024
GPU_DEVICES=2,3
PORT=3847
HOST=127.0.0.1
SERVED_NAME=qwen3.8-27b-llamacpp
BATCH=2048
DRAFT_UBATCH=64
DRAFT_TOKENS=3
VISION_GPU=CUDA0
IMAGE_MIN_TOKENS=64
IMAGE_MAX_TOKENS=4096
CPU_THREADS=16
REASONING=off

# Automatic committed-prefix reuse; use a dedicated directory, not a vLLM cache root.
PERSISTENT_CACHE=1
# KV_CACHE_DIR=/path/to/dedicated/llama-kv-cache
KV_CACHE_RAM_MIB=512
KV_CACHE_MAX_MIB=163840
KV_CACHE_TARGET_MIB=131072
KV_CACHE_MIN_FREE_MIB=16384
