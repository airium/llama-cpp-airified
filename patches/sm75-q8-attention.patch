+            return value && std::atoi(value) != 0;
+        }();
+        const int cc = ggml_cuda_info().devices[ctx.device].cc;
+        const bool sm75 = cc == GGML_CUDA_CC_TURING && ggml_cuda_highest_compiled_arch(cc) == GGML_CUDA_CC_TURING;
+        const bool shared = sm75 && shared_prefill && dst->src[0]->ne[1] >= 32 && ncols1 * ncols2 == 32;
+        const bool alias = sm75 && alias_enabled && !shared;
