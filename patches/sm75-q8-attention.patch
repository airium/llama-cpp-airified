+            } else {
+                ggml_cuda_flash_attn_ext_mma_f16_case_impl<DKQ, DV, ncols1, ncols2, FATTN_SM75_Q8>(ctx, dst);
+            }
+            return;
+        }
+        if constexpr (ncols1 * ncols2 == 32) {
+            if (shared) {
+                ggml_cuda_flash_attn_ext_mma_f16_case_impl<DKQ, DV, ncols1, ncols2, FATTN_SM75_Q_SHARED>(ctx, dst);
