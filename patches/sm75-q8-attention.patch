+static inline bool ggml_cuda_flash_attn_ext_use_sm75_q8(const ggml_tensor * dst, const int device) {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_CUDA_SM75_Q8_FUSION");
+        return value && std::atoi(value) == 1;
+    }();
+    const int cc = ggml_cuda_info().devices[device].cc;
+    if (!enabled || cc != GGML_CUDA_CC_TURING || ggml_cuda_highest_compiled_arch(cc) != GGML_CUDA_CC_TURING) {
+        return false;
+    }
+    static const int max_queries = [] {
+        const char * value = std::getenv("GGML_CUDA_SM75_Q8_FUSION_MAX_Q");
+        return value ? std::atoi(value) : 0;
+    }();
+    if (max_queries > 0 && dst->src[0]->ne[1] > max_queries) {
+        return false;
+    }
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    const bool shared = V->view_src && (V->view_src == K || (V->view_src == K->view_src && V->view_offs == K->view_offs));
+    return K->type == GGML_TYPE_Q8_0 && V->type == GGML_TYPE_Q8_0 && K->ne[0] == 256 && V->ne[0] == 256 &&
+        K->nb[0] == sizeof(block_q8_0) && V->nb[0] == sizeof(block_q8_0) &&
+        K->nb[1] % sizeof(half2) == 0 && V->nb[1] % sizeof(half2) == 0 && !shared;
+}
+
 static inline ggml_cuda_flash_attn_ext_f16_extra_data ggml_cuda_flash_attn_ext_get_f16_extra_data(
         const ggml_tensor * dst, const bool need_f16_K, const bool need_f16_V) {
     GGML_ASSERT(dst->op == GGML_OP_FLASH_ATTN_EXT);
