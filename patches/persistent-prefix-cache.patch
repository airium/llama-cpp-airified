+#pragma once
+
+#include "server-task.h"
+
+#include <memory>
+
+struct server_persist_options {
+    std::string directory;
+    std::string identity;
+    bool        cache_hot      = true;
+    size_t      ram_bytes      = 512ull << 20;
+    uint64_t    max_bytes      = 160ull << 30;
+    uint64_t    target_bytes   = 128ull << 30;
+    uint64_t    min_free_bytes = 16ull << 30;
+};
+
+class server_persistent_cache {
+  public:
+    explicit server_persistent_cache(const server_persist_options & options);
+    ~server_persistent_cache();
+    bool               save(const server_prompt &        prompt,
+                            llama_context *              target,
+                            llama_context *              draft,
+                            llama_seq_id                 seq,
+                            const std::vector<uint8_t> & spec,
+                            size_t                       prefix_tokens = 0);
+    bool               load(server_prompt &        prompt,
+                            const server_tokens &  incoming,
+                            llama_context *        target,
+                            llama_context *        draft,
+                            llama_seq_id           seq,
+                            std::vector<uint8_t> & spec);
+    json               stats() const;
+    static std::string identity(const common_params & params);
+  private:
+    struct impl;
+    std::unique_ptr<impl> p;
+};
