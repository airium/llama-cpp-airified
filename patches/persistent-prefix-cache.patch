diff --git a/tests/test-server-persist.cpp b/tests/test-server-persist.cpp
new file mode 100644
index 0000000..33048ae
--- /dev/null
+++ b/tests/test-server-persist.cpp
@@ -0,0 +1,166 @@
+#include "hash/hash.h"
+#include "server-persist.h"
+#include "testing.h"
+
+#include <unistd.h>
+
+#include <filesystem>
+#include <fstream>
+
+namespace fs = std::filesystem;
+
+struct fixture {
+    fs::path               root;
+    server_persist_options options;
+
+    fixture() {
+        char   pattern[] = "/tmp/llama-persist-test-XXXXXX";
+        char * directory = mkdtemp(pattern);
+        if (!directory) {
+            throw std::runtime_error("mkdtemp failed");
+        }
+        root                   = directory;
+        options.directory      = root.string();
+        options.identity       = std::string(64, 'a');
+        options.ram_bytes      = 64u << 20;
+        options.max_bytes      = 2u << 20;
+        options.target_bytes   = 1u << 20;
+        options.min_free_bytes = 0;
+        {
+            server_persistent_cache cache(options);
+        }
+    }
+
+    ~fixture() { fs::remove_all(root); }
+
+    static void write(const fs::path & path, const std::string & value) {
+        std::ofstream file(path, std::ios::binary);
+        file << value;
+        if (!file) {
+            throw std::runtime_error("test file write failed");
+        }
+    }
+
+    std::string blob(char value, size_t bytes) {
+        std::string data(bytes, value);
+        auto        hash = hash_sha256_hex(data.data(), data.size());
+        write(root / "objects" / (hash + ".bin"), data);
+        return hash;
+    }
+
+    fs::path entry(char id, const std::string & hash, size_t bytes, int hits, int access) {
+        json empty = {
+            { "bytes",  0             },
+            { "chunks", json::array() }
+        };
+        json stream = {
+            { "bytes",  bytes                                         },
+            { "chunks", json::array({ json::array({ hash, bytes }) }) }
+        };
+        json value = {
+            { "version",     1                                     },
+            { "identity",    options.identity                      },
+            { "n_tokens",    64                                    },
+            { "prefixes",    json::array({ std::string(64, 'b') }) },
+            { "checkpoints", json::array()                         },
+            { "target",      stream                                },
+            { "draft",       empty                                 },
+            { "tokens",      empty                                 },
+            { "spec",        empty                                 },
+            { "hits",        hits                                  },
+            { "access",      access                                }
+        };
+        auto canonical    = value.dump();
+        value["checksum"] = hash_sha256_hex(canonical.data(), canonical.size());
+        auto path         = root / "entries" / (std::string(64, id) + ".json");
+        write(path, value.dump());
+        return path;
+    }
+};
+
+int main(int argc, char ** argv) {
+    testing t;
+    if (argc > 1) {
+        t.set_filter(argv[1]);
+    }
+    t.test("exclusive root lease", [](testing & t) {
+        fixture                 f;
+        server_persistent_cache first(f.options);
+        bool                    rejected = false;
+        try {
+            server_persistent_cache second(f.options);
+        } catch (const std::exception &) {
+            rejected = true;
+        }
+        t.assert_true("second writer rejected", rejected);
+        t.assert_equal("first writer alive", size_t(0), first.stats()["entries"].get<size_t>());
+    });
+    t.test("crash leftovers and invalid manifests", [](testing & t) {
+        fixture f;
+        auto    hash = f.blob('x', 4096);
+        fixture::write(f.root / "objects" / "pending.bin.tmp", "partial");
+        fixture::write(f.root / "entries" / "pending.json.tmp", "partial");
+        auto path = f.entry('c', hash, 4096, 0, 1);
+        fixture::write(path, "{\"checksum\":\"wrong\"}");
+        server_persistent_cache cache(f.options);
+        t.assert_equal("invalid entry removed", size_t(0), cache.stats()["entries"].get<size_t>());
+        t.assert_true("no orphan objects", fs::is_empty(f.root / "objects"));
+        t.assert_true("no partial manifests", fs::is_empty(f.root / "entries"));
+    });
+    t.test("byte quota protects reused entries", [](testing & t) {
+        fixture f;
+        auto    shared         = f.blob('s', 700000);
+        auto    cold           = f.blob('c', 700000);
+        auto    keep           = f.entry('a', shared, 700000, 1, 1);
+        auto    alias          = f.entry('b', shared, 700000, 0, 2);
+        auto    evict          = f.entry('c', cold, 700000, 0, 3);
+        f.options.max_bytes    = 1100000;
+        f.options.target_bytes = 800000;
+        server_persistent_cache cache(f.options);
+        t.assert_true("reused entry retained", fs::exists(keep));
+        t.assert_true("probation entries evicted", !fs::exists(alias) && !fs::exists(evict));
+        t.assert_true("shared object retained", fs::exists(f.root / "objects" / (shared + ".bin")));
+        t.assert_true("unused object deleted", !fs::exists(f.root / "objects" / (cold + ".bin")));
+        t.assert_true("quota met", cache.stats()["disk_bytes"].get<size_t>() <= f.options.max_bytes);
+    });
+    t.test("missing objects invalidate a snapshot", [](testing & t) {
+        fixture                 f;
+        auto                    path = f.entry('d', std::string(64, 'e'), 4000, 0, 1);
+        server_persistent_cache cache(f.options);
+        t.assert_true("manifest removed", !fs::exists(path));
+        t.assert_equal("safe empty cache", size_t(0), cache.stats()["entries"].get<size_t>());
+    });
+    t.test("unrelated directory is preserved", [](testing & t) {
+        fixture f;
+        fs::remove(f.root / ".llama-persist-format");
+        fixture::write(f.root / "important.txt", "keep");
+        bool rejected = false;
+        try {
+            server_persistent_cache cache(f.options);
+        } catch (const std::exception &) {
+            rejected = true;
+        }
+        t.assert_true("refuses unrelated data", rejected);
+        t.assert_true("file retained", fs::exists(f.root / "important.txt"));
+    });
+    t.test("strong model identity and memo invalidation", [](testing & t) {
+        fixture f;
+        auto    model = f.root / "test-model.gguf";
+        fixture::write(model, "model-A");
+        common_params params;
+        params.cache_dir_path = f.root.string();
+        params.model.path     = model.string();
+        const auto first      = server_persistent_cache::identity(params);
+        t.assert_true("unchanged identity is stable", first == server_persistent_cache::identity(params));
+        const auto time = fs::last_write_time(model);
+        fixture::write(model, "model-B");
+        fs::last_write_time(model, time);
+        const auto changed = server_persistent_cache::identity(params);
+        t.assert_true("same-size same-mtime edit invalidates memo", first != changed);
+        const auto moved = f.root / "renamed-model.gguf";
+        fs::rename(model, moved);
+        params.model.path = moved.string();
+        t.assert_true("content identity survives a path change", changed == server_persistent_cache::identity(params));
+    });
+    return t.summary();
+}
