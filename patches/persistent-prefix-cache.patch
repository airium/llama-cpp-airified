new file mode 100644
index 0000000..bb3aa1b
--- /dev/null
+++ b/tools/server/server-persist.cpp
@@ -0,0 +1,1160 @@
+#include "server-persist.h"
+
+#include "ggml-backend.h"
+#include "hash/hash.h"
+#include "llama-ext.h"
+#include "llama-io.h"
+#include "log.h"
+extern "C" {
+#include "hash/sha256/sha256.h"
+}
+#ifdef LLAMA_PERSIST_OPENSSL
+#    include <openssl/evp.h>
+#endif
+#include <fcntl.h>
+#include <link.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <future>
+#include <limits>
+#include <list>
+#include <mutex>
+#include <set>
+#include <thread>
+#include <unordered_map>
+
+namespace {
+namespace fs                  = std::filesystem;
+constexpr size_t blob_bytes   = 4u << 20;
+constexpr size_t manifest_max = 16u << 20;
+constexpr size_t prefix_step  = 64;
+
+uint64_t stamp() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::system_clock::now().time_since_epoch())
+        .count();
+}
+
+bool digest_ok(const std::string & s) {
+    return s.size() == 64 && s.find_first_not_of("0123456789abcdef") == std::string::npos;
+}
+
+void require(bool ok, const char * msg) {
+    if (!ok) {
+        throw std::runtime_error(msg);
+    }
+}
+
+class cache_hasher {
+#ifdef LLAMA_PERSIST_OPENSSL
+    std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)> ctx{ EVP_MD_CTX_new(), EVP_MD_CTX_free };
+#else
+    sha256_t ctx;
+#endif
+  public:
+    cache_hasher() {
+#ifdef LLAMA_PERSIST_OPENSSL
+        require(ctx && EVP_DigestInit_ex(ctx.get(), EVP_sha256(), nullptr) == 1, "cannot initialize cache checksum");
+#else
+        sha256_init(&ctx);
+#endif
+    }
+
+    void update(const void * data, size_t size) {
+#ifdef LLAMA_PERSIST_OPENSSL
+        require(EVP_DigestUpdate(ctx.get(), data, size) == 1, "cannot hash cache data");
+#else
+        sha256_update(&ctx, static_cast<const unsigned char *>(data), size);
+#endif
+    }
+
+    std::string finish() {
+        unsigned char digest[32];
+#ifdef LLAMA_PERSIST_OPENSSL
+        unsigned int size = 0;
+        require(EVP_DigestFinal_ex(ctx.get(), digest, &size) == 1 && size == 32, "cannot finish cache checksum");
+#else
+        sha256_final(&ctx, digest);
+#endif
+        std::string  hex;
+        const char * chars = "0123456789abcdef";
+        for (auto c : digest) {
+            hex += chars[c >> 4];
+            hex += chars[c & 15];
+        }
+        return hex;
+    }
+};
+
+std::string cache_hash(const void * data, size_t size) {
+    cache_hasher hash;
+    hash.update(data, size);
+    return hash.finish();
+}
+
+void sync_dir(const fs::path & path) {
+    int fd = open(path.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    require(fd >= 0, "cannot open cache directory");
+    int result = fsync(fd);
+    close(fd);
+    require(result == 0, "cannot sync cache directory");
+}
+
+void atomic_file(const fs::path & path, const void * data, size_t size) {
+    fs::path temp = path.string() + ".tmp";
+    int      fd   = open(temp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW, 0600);
+    require(fd >= 0, "cannot create cache temporary file");
+    const auto * ptr = static_cast<const uint8_t *>(data);
+    try {
+        while (size) {
+            ssize_t n = write(fd, ptr, size);
+            if (n < 0 && errno == EINTR) {
+                continue;
+            }
+            require(n > 0, "cache write failed");
+            ptr += n;
+            size -= n;
+        }
+        require(fsync(fd) == 0, "cache data sync failed");
+        close(fd);
+        fd = -1;
+        fs::rename(temp, path);
+    } catch (...) {
+        if (fd >= 0) {
+            close(fd);
+        }
+        std::error_code ec;
+        fs::remove(temp, ec);
+        throw;
+    }
+}
+
+std::vector<uint8_t> read_file(const fs::path & path, size_t limit) {
+    int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    require(fd >= 0, "cache file missing");
+    struct stat st{};
+    if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size < 0 || uint64_t(st.st_size) > limit) {
+        close(fd);
+        throw std::runtime_error("invalid cache file size");
+    }
+    std::vector<uint8_t> data(size_t(st.st_size));
+    size_t               pos = 0;
+    while (pos < data.size()) {
+        ssize_t n = read(fd, data.data() + pos, data.size() - pos);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n <= 0) {
+            close(fd);
+            throw std::runtime_error("truncated cache file");
+        }
+        pos += size_t(n);
+    }
+    close(fd);
+    return data;
+}
+
+void root_prepare(const fs::path & root) {
+    fs::create_directories(root);
+    auto marker = root / ".llama-persist-format";
+    if (!fs::exists(marker)) {
+        require(fs::is_empty(root), "persistent cache requires an empty dedicated directory");
+        const std::string value = "llama-persist-1\n";
+        atomic_file(marker, value.data(), value.size());
+        sync_dir(root);
+    }
+    auto data = read_file(marker, 64);
+    require(std::string(data.begin(), data.end()) == "llama-persist-1\n", "unknown persistent cache directory format");
+    require(chmod(root.c_str(), 0700) == 0, "cannot secure cache directory");
+}
+
+json manifest_read(const fs::path & path) {
+    auto        data     = read_file(path, manifest_max);
+    json        result   = json::parse(std::string(data.begin(), data.end()));
+    std::string checksum = result.at("checksum");
+    result.erase("checksum");
+    auto canonical = result.dump();
+    require(checksum == cache_hash(canonical.data(), canonical.size()), "cache manifest checksum mismatch");
+    return result;
+}
+
+void manifest_write(const fs::path & path, json value) {
+    auto canonical    = value.dump();
+    value["checksum"] = cache_hash(canonical.data(), canonical.size());
+    auto data         = value.dump();
+    require(data.size() <= manifest_max, "cache manifest too large");
+    atomic_file(path, data.data(), data.size());
+    sync_dir(path.parent_path());
+}
+
+std::vector<std::string> prefix_hashes(const server_tokens & tokens) {
+    std::vector<std::string> result;
+    std::string              chain, block;
+    std::string              media_id;
+    size_t                   media_end = 0;
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        llama_token t = tokens[i];
+        block.append(reinterpret_cast<const char *>(&t), sizeof(t));
+        if (t == LLAMA_TOKEN_NULL) {
+            if (i >= media_end) {
+                const auto & media = tokens.find_chunk(i);
+                require(bool(media), "missing media identity");
+                media_id  = mtmd_input_chunk_get_id(media.get());
+                media_end = i + mtmd_input_chunk_get_n_tokens(media.get());
+                require(media_end > i && media_end <= tokens.size(), "invalid media span");
+            }
+            require(media_id.size() <= 4096, "media identity too large");
+            uint64_t n = media_id.size();
+            block.append(reinterpret_cast<const char *>(&n), sizeof(n));
+            block += media_id;
+        }
+        if ((i + 1) % prefix_step == 0) {
+            auto bytes = chain + block;
+            chain      = cache_hash(bytes.data(), bytes.size());
+            result.push_back(chain);
+            block.clear();
+        }
+    }
+    return result;
+}
+
+// A recurrent state can rewind only to a retained checkpoint, not to any attention cell.
+size_t reusable(const server_prompt & prompt, const server_tokens & incoming, bool hybrid) {
+    size_t common = prompt.tokens.get_common_prefix(incoming);
+    if (!hybrid) {
+        return common;
+    }
+    size_t limit = std::min(common, incoming.size() ? incoming.size() - 1 : 0);
+    if (prompt.tokens.size() <= limit) {
+        return prompt.tokens.size();
+    }
+    size_t best = 0;
+    for (const auto & c : prompt.checkpoints) {
+        if (c.n_tokens >= 0 && size_t(c.n_tokens) <= limit) {
+            best = std::max(best, size_t(c.n_tokens));
+        }
+    }
+    return best;
+}
+}  // namespace
+
+struct server_persistent_cache::impl {
+    server_persist_options        options;
+    fs::path                      root, objects, entries;
+    int                           lock_fd = -1;
+    std::map<std::string, json>   index;
+    std::map<std::string, size_t> sizes, references;
+    std::set<std::string>         transaction, corrupt, verified;
+    uint64_t                      used           = 0;
+    size_t                        metadata_bytes = 0;
+
+    struct job {
+        std::string                           hash;
+        std::shared_ptr<std::vector<uint8_t>> bytes;
+    };
+
+    struct hot_item {
+        std::shared_ptr<std::vector<uint8_t>> bytes;
+        std::list<std::string>::iterator      order;
+    };
+
+    std::unordered_map<std::string, hot_item> hot;
+    std::list<std::string>                    order;
+    size_t                  hot_bytes = 0, queued_bytes = 0, peak_hot_bytes = 0, peak_queued_bytes = 0;
+    std::deque<job>         jobs;
+    std::mutex              mutex;
+    std::condition_variable changed;
+    bool                    stopping = false;
+    std::string             error;
+    std::thread             worker;
+    uint64_t saved_bytes = 0, reused_bytes = 0, read_bytes = 0, ram_read_bytes = 0, evictions = 0, saves = 0, hits = 0,
+             misses = 0, gpu_hits = 0, verification_read_bytes = 0;
+
+    explicit impl(const server_persist_options & opts) :
+        options(opts),
+        root(opts.directory),
+        objects(root / "objects"),
+        entries(root / "entries") {
+        require(opts.ram_bytes >= 64 * 1024 * 1024, "persistent RAM budget must be at least 64 MiB");
+        require(opts.max_bytes > 0 && opts.target_bytes <= opts.max_bytes, "invalid persistent disk watermarks");
+        root_prepare(root);
+        lock_fd = open((root / ".writer.lock").c_str(), O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+        require(lock_fd >= 0, "cannot open persistent cache lock");
+        if (flock(lock_fd, LOCK_EX | LOCK_NB)) {
+            close(lock_fd);
+            lock_fd = -1;
+            throw std::runtime_error("persistent cache already has a writer; use a separate directory");
+        }
+        try {
+            fs::create_directories(objects);
+            fs::create_directories(entries);
+            for (const auto & f : fs::directory_iterator(objects)) {
+                auto name = f.path().filename().string();
+                if (f.path().extension() == ".tmp") {
+                    fs::remove(f.path());
+                    continue;
+                }
+                if (f.path().extension() == ".bin" && digest_ok(f.path().stem().string()) && !f.is_symlink()) {
+                    size_t n = f.file_size();
+                    if (n > 0 && n <= blob_bytes) {
+                        sizes[f.path().stem().string()] = n;
+                        used += n;
+                    } else {
+                        fs::remove(f.path());
+                    }
+                }
+            }
+            for (const auto & f : fs::directory_iterator(entries)) {
+                if (f.path().extension() == ".tmp") {
+                    fs::remove(f.path());
+                    continue;
+                }
+                if (f.path().extension() != ".json" || !digest_ok(f.path().stem().string())) {
+                    continue;
+                }
+                try {
+                    json value = manifest_read(f.path());
+                    validate(value);
+                    metadata_bytes += manifest_bytes(value);
+                    visit(value, [&](const std::string & h, size_t) { ++references[h]; });
+                    index[f.path().stem().string()] = std::move(value);
+                    while (metadata_bytes * 8 > metadata_limit()) {
+                        if (!evict(false)) {
+                            break;
+                        }
+                    }
+                } catch (const std::exception & e) {
+                    SRV_WRN("discarding invalid persistent entry: %s\n", e.what());
+                    fs::remove(f.path());
+                }
+            }
+            collect();
+            while (used + metadata_bytes > options.max_bytes || metadata_bytes * 8 > metadata_limit()) {
+                if (!evict()) {
+                    break;
+                }
+            }
+            worker = std::thread([this] { run(); });
+            SRV_INF("persistent cache: %zu entries, %.3f GiB, RAM limit %.0f MiB\n", index.size(),
+                    used / double(1ull << 30), options.ram_bytes / double(1ull << 20));
+        } catch (...) {
+            close(lock_fd);
+            lock_fd = -1;
+            throw;
+        }
+    }
+
+    ~impl() {
+        {
+            std::lock_guard<std::mutex> guard(mutex);
+            stopping = true;
+            changed.notify_all();
+        }
+        if (worker.joinable()) {
+            worker.join();
+        }
+        if (lock_fd >= 0) {
+            close(lock_fd);
+        }
+    }
+
+    static size_t manifest_bytes(const json & value) { return value.dump().size() + 78; }
+
+    size_t metadata_limit() const { return std::min<size_t>(64u << 20, options.ram_bytes / 4); }
+
+    size_t staging_limit() const { return std::min<size_t>(64u << 20, options.ram_bytes / 8); }
+
+    size_t pool_limit() const {
+        return (options.ram_bytes - metadata_limit() - 2 * staging_limit() - 2 * blob_bytes) / 2;
+    }
+
+    template <class F> static void visit_stream(const json & stream, F fn) {
+        uint64_t total = 0;
+        require(stream.at("chunks").is_array() && stream["chunks"].size() <= 65536, "invalid cache chunk count");
+        for (const auto & c : stream["chunks"]) {
+            require(c.is_array() && c.size() == 2, "invalid cache chunk");
+            std::string h = c[0];
+            uint64_t    n = c[1].get<uint64_t>();
+            require(digest_ok(h) && n > 0 && n <= blob_bytes, "invalid cache object");
+            require(total <= UINT64_MAX - n, "cache stream overflow");
+            total += n;
+            fn(h, size_t(n));
+        }
+        require(total == stream.at("bytes").get<uint64_t>(), "cache stream size mismatch");
+    }
+
+    template <class F> static void visit(const json & value, F fn) {
+        for (const char * key : { "target", "draft", "spec", "tokens" }) {
+            visit_stream(value.at(key), fn);
+        }
+        for (const auto & c : value.at("checkpoints")) {
+            for (const char * key : { "target", "draft", "spec" }) {
+                visit_stream(c.at(key), fn);
+            }
+        }
+    }
+
+    void validate(const json & v) {
+        require(v.at("version") == 1 && digest_ok(v.at("identity")), "incompatible cache manifest");
+        uint64_t n = v.at("n_tokens").get<uint64_t>();
+        require(n > 0 && n <= (4u << 20), "invalid cache token count");
+        require(v.at("prefixes").is_array() && v.at("prefixes").size() == n / prefix_step,
+                "invalid cache prefix count");
+        for (const auto & h : v.at("prefixes")) {
+            require(digest_ok(h), "invalid cache prefix hash");
+        }
+        require(v.at("hits").get<int64_t>() >= 0 && v.at("access").get<int64_t>() >= 0,
+                "invalid cache eviction metadata");
+        require(v.at("checkpoints").is_array() && v["checkpoints"].size() <= 1024, "too many cached checkpoints");
+        for (const auto & c : v["checkpoints"]) {
+            require(c.at("n_tokens").get<int64_t>() >= 0 && c.at("n_tokens").get<uint64_t>() <= n,
+                    "invalid checkpoint boundary");
+        }
+        visit(v, [&](const std::string & h, size_t bytes) {
+            require(sizes.count(h) && sizes.at(h) == bytes, "missing persistent object");
+        });
+    }
+
+    void invalidate_corrupt() {
+        std::set<std::string> bad;
+        {
+            std::lock_guard<std::mutex> guard(mutex);
+            bad.swap(corrupt);
+        }
+        if (bad.empty()) {
+            return;
+        }
+        std::vector<std::string> invalid;
+        for (const auto & item : index) {
+            bool found = false;
+            visit(item.second, [&](const std::string & h, size_t) {
+                if (bad.count(h)) {
+                    found = true;
+                }
+            });
+            if (found) {
+                invalid.push_back(item.first);
+            }
+        }
+        for (const auto & id : invalid) {
+            remove_entry(id);
+        }
+    }
+
+    void collect() {
+        for (auto it = sizes.begin(); it != sizes.end();) {
+            if (!references[it->first] && !transaction.count(it->first)) {
+                fs::remove(objects / (it->first + ".bin"));
+                used -= it->second;
+                {
+                    std::lock_guard<std::mutex> guard(mutex);
+                    verified.erase(it->first);
+                }
+                references.erase(it->first);
+                it = sizes.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+
+    void remove_entry(const std::string & id, bool gc = true) {
+        auto it = index.find(id);
+        if (it == index.end()) {
+            return;
+        }
+        visit(it->second, [&](const std::string & h, size_t) {
+            if (references[h]) {
+                --references[h];
+            }
+        });
+        metadata_bytes -= manifest_bytes(it->second);
+        fs::remove(entries / (id + ".json"));
+        index.erase(it);
+        if (gc) {
+            collect();
+        }
+    }
+
+    bool evict(bool gc = true) {
+        if (index.empty()) {
+            return false;
+        }
+        auto best = std::min_element(index.begin(), index.end(), [](const auto & a, const auto & b) {
+            return std::make_pair(a.second.value("hits", 0) > 0, a.second.value("access", uint64_t(0))) <
+                   std::make_pair(b.second.value("hits", 0) > 0, b.second.value("access", uint64_t(0)));
+        });
+        remove_entry(best->first, gc);
+        ++evictions;
+        return true;
+    }
+
+    size_t pending_bytes() {
+        std::lock_guard<std::mutex> guard(mutex);
+        return queued_bytes;
+    }
+
+    void space(size_t incoming) {
+        auto available = [&] {
+            return fs::space(root).available;
+        };
+        if (used + metadata_bytes + incoming > options.max_bytes ||
+            available() < options.min_free_bytes + incoming + pending_bytes()) {
+            drain();
+            while (used + metadata_bytes + incoming > options.target_bytes ||
+                   available() < options.min_free_bytes + incoming) {
+                if (!evict()) {
+                    break;
+                }
+            }
+            require(used + metadata_bytes + incoming <= options.max_bytes &&
+                        available() >= options.min_free_bytes + incoming,
+                    "persistent cache quota or free-space limit");
+        }
+    }
+
+    void run() {
+        for (;;) {
+            job current;
+            {
+                std::unique_lock<std::mutex> guard(mutex);
+                changed.wait(guard, [&] { return stopping || !jobs.empty(); });
+                if (jobs.empty()) {
+                    if (stopping) {
+                        return;
+                    }
+                    continue;
+                }
+                current = std::move(jobs.front());
+                jobs.pop_front();
+            }
+            std::string failure;
+            try {
+                atomic_file(objects / (current.hash + ".bin"), current.bytes->data(), current.bytes->size());
+            } catch (const std::exception & e) {
+                failure = e.what();
+            }
+            {
+                std::lock_guard<std::mutex> guard(mutex);
+                if (!failure.empty()) {
+                    error = failure;
+                } else {
+                    saved_bytes += current.bytes->size();
+                }
+                queued_bytes -= current.bytes->capacity();
+                changed.notify_all();
+            }
+        }
+    }
+
+    void drain() {
+        std::unique_lock<std::mutex> guard(mutex);
+        changed.wait(guard, [&] { return queued_bytes == 0; });
+        require(error.empty(), error.c_str());
+    }
+
+    std::string put(std::vector<uint8_t> data) {
+        std::string h = cache_hash(data.data(), data.size());
+        transaction.insert(h);
+        const bool exists = sizes.count(h) != 0;
+        if (exists) {
+            bool valid;
+            {
+                std::lock_guard<std::mutex> guard(mutex);
+                valid = verified.count(h) != 0;
+            }
+            if (!valid) {
+                try {
+                    auto previous = read_file(objects / (h + ".bin"), blob_bytes);
+                    verification_read_bytes += previous.size();
+                    valid = previous == data;
+                } catch (...) {
+                }
+            }
+            if (valid) {
+                std::lock_guard<std::mutex> guard(mutex);
+                verified.insert(h);
+                reused_bytes += data.size();
+                return h;
+            }
+        }
+        data.shrink_to_fit();
+        space(data.size());
+        std::unique_lock<std::mutex> guard(mutex);
+        changed.wait(guard, [&] {
+            return (queued_bytes + data.capacity() <= pool_limit() && jobs.size() < 256) || !error.empty();
+        });
+        require(error.empty(), error.c_str());
+        queued_bytes += data.capacity();
+        peak_queued_bytes = std::max(peak_queued_bytes, queued_bytes);
+        verified.insert(h);
+        if (!exists) {
+            sizes[h] = data.size();
+            used += data.size();
+        }
+        jobs.push_back({ h, std::make_shared<std::vector<uint8_t>>(std::move(data)) });
+        changed.notify_all();
+        return h;
+    }
+
+    std::shared_ptr<std::vector<uint8_t>> get(const std::string & h, size_t expected) {
+        {
+            std::lock_guard<std::mutex> guard(mutex);
+            auto                        it = hot.find(h);
+            if (it != hot.end()) {
+                order.splice(order.end(), order, it->second.order);
+                ram_read_bytes += expected;
+                return it->second.bytes;
+            }
+        }
+        std::shared_ptr<std::vector<uint8_t>> data;
+        try {
+            data = std::make_shared<std::vector<uint8_t>>(read_file(objects / (h + ".bin"), blob_bytes));
+            require(data->size() == expected && cache_hash(data->data(), data->size()) == h,
+                    "persistent object checksum mismatch");
+        } catch (...) {
+            std::lock_guard<std::mutex> guard(mutex);
+            corrupt.insert(h);
+            throw;
+        }
+        {
+            std::lock_guard<std::mutex> guard(mutex);
+            verified.insert(h);
+            read_bytes += data->size();
+            if (!options.cache_hot) {
+                return data;
+            }
+            auto found = hot.find(h);
+            if (found != hot.end()) {
+                order.splice(order.end(), order, found->second.order);
+                return found->second.bytes;
+            }
+            while (!order.empty() && hot_bytes + data->size() > pool_limit()) {
+                auto it = hot.find(order.front());
+                hot_bytes -= it->second.bytes->size();
+                hot.erase(it);
+                order.pop_front();
+            }
+            order.push_back(h);
+            hot[h] = { data, std::prev(order.end()) };
+            hot_bytes += data->size();
+            peak_hot_bytes = std::max(peak_hot_bytes, hot_bytes);
+        }
+        return data;
+    }
+
+    struct writer : llama_io_write_i {
+        impl & store;
+        json   result = {
+            { "chunks", json::array() },
+            { "bytes",  0             }
+        };
+        std::vector<uint8_t> buffer;
+        size_t               count = 0;
+
+        explicit writer(impl & s) : store(s) { buffer.reserve(blob_bytes); }
+
+        void flush() {
+            if (buffer.empty()) {
+                return;
+            }
+            size_t n = buffer.size();
+            auto   h = store.put(std::move(buffer));
+            result["chunks"].push_back(json::array({ h, n }));
+            buffer.clear();
+            buffer.reserve(blob_bytes);
+        }
+
+        void write(const void * src, size_t n) override {
+            const auto * data = static_cast<const uint8_t *>(src);
+            count += n;
+            while (n) {
+                size_t step = std::min(n, blob_bytes - buffer.size());
+                buffer.insert(buffer.end(), data, data + step);
+                data += step;
+                n -= step;
+                if (buffer.size() == blob_bytes) {
+                    flush();
+                }
+            }
+        }
+
+        void write_tensor(ggml_tensor * t, size_t offset, size_t n) override {
+            // Keep tensor boundaries stable when a cached sequence grows.
+            flush();
+            size_t row = t->nb[1];
+            require(row > 0, "invalid state tensor row");
+            size_t step = std::max(row, (blob_bytes / row) * row);
+            require(step <= store.staging_limit(), "state tensor row exceeds staging limit");
+            std::vector<uint8_t> staging(std::min(step, n));
+            while (n) {
+                size_t take = std::min(step, n);
+                ggml_backend_tensor_get(t, staging.data(), offset, take);
+                write(staging.data(), take);
+                offset += take;
+                n -= take;
+            }
+            flush();
+        }
+
+        size_t n_bytes() override { return count; }
+
+        json finish() {
+            flush();
+            result["bytes"] = count;
+            return result;
+        }
+    };
+
+    struct reader : llama_io_read_i {
+        impl &                                             store;
+        json                                               stream;
+        size_t                                             chunk = 0, pos = 0, count = 0;
+        std::shared_ptr<std::vector<uint8_t>>              current;
+        std::future<std::shared_ptr<std::vector<uint8_t>>> next;
+
+        reader(impl & s, const json & value) : store(s), stream(value) { prefetch(); }
+
+        void prefetch() {
+            if (chunk < stream["chunks"].size()) {
+                auto part = stream["chunks"][chunk++];
+                next      = std::async(std::launch::async, [this, part] {
+                    return store.get(part[0].get<std::string>(), part[1].get<size_t>());
+                });
+            }
+        }
+
+        void read(void * dst, size_t n) override {
+            require(n <= stream.at("bytes").get<uint64_t>() - count, "truncated persistent state");
+            auto * output = static_cast<uint8_t *>(dst);
+            while (n) {
+                if (!current) {
+                    current = next.get();
+                    prefetch();
+                    pos = 0;
+                }
+                size_t step = std::min(n, current->size() - pos);
+                memcpy(output, current->data() + pos, step);
+                pos += step;
+                count += step;
+                output += step;
+                n -= step;
+                if (pos == current->size()) {
+                    current.reset();
+                }
+            }
+        }
+
+        void read_tensor(ggml_tensor * t, size_t offset, size_t n) override {
+            size_t row = t->nb[1];
+            require(row > 0, "invalid state tensor row");
+            size_t step = std::max(row, (blob_bytes / row) * row);
+            require(step <= store.staging_limit(), "state tensor row exceeds staging limit");
+            std::vector<uint8_t> staging(std::min(step, n));
+            while (n) {
+                size_t take = std::min(step, n);
+                read(staging.data(), take);
+                ggml_backend_tensor_set(t, staging.data(), offset, take);
+                offset += take;
+                n -= take;
+            }
+        }
+
+        size_t n_bytes() override { return count; }
+    };
+
+    json bytes(const void * data, size_t size) {
+        writer w(*this);
+        w.write(data, size);
+        return w.finish();
+    }
+
+    std::vector<uint8_t> bytes(const json & stream, size_t limit) {
+        require(stream["bytes"].get<uint64_t>() <= limit, "persistent auxiliary state too large");
+        std::vector<uint8_t> data(stream["bytes"].get<size_t>());
+        reader               in(*this, stream);
+        in.read(data.data(), data.size());
+        return data;
+    }
+};
+
+server_persistent_cache::server_persistent_cache(const server_persist_options & options) : p(new impl(options)) {}
+
+server_persistent_cache::~server_persistent_cache() = default;
+
+bool server_persistent_cache::save(const server_prompt &        prompt,
+                                   llama_context *              target,
+                                   llama_context *              draft,
+                                   llama_seq_id                 seq,
+                                   const std::vector<uint8_t> & spec,
+                                   size_t                       prefix_tokens) {
+    auto started = stamp();
+    try {
+        auto tokens = prompt.tokens.clone();
+        if (prefix_tokens) {
+            tokens.keep_first(prefix_tokens);
+        }
+        if (tokens.size() < prefix_step) {
+            return false;
+        }
+        auto        packed = tokens.serialize();
+        std::string key    = p->options.identity + cache_hash(packed.data(), packed.size());
+        key                = cache_hash(key.data(), key.size());
+        auto existing      = p->index.find(key);
+        if (existing != p->index.end()) {
+            existing->second["access"] = stamp();
+            manifest_write(p->entries / (key + ".json"), existing->second);
+            return true;
+        }
+        p->transaction.clear();
+        json value = {
+            { "version",     1                     },
+            { "identity",    p->options.identity   },
+            { "n_tokens",    tokens.size()         },
+            { "prefixes",    prefix_hashes(tokens) },
+            { "access",      stamp()               },
+            { "hits",        0                     },
+            { "checkpoints", json::array()         }
+        };
+        {
+            impl::writer out(*p);
+            require(llama_state_seq_write_io(target, seq, out) > 0, "target state save failed");
+            value["target"] = out.finish();
+        }
+        {
+            impl::writer out(*p);
+            if (draft) {
+                require(llama_state_seq_write_io(draft, seq, out) > 0, "draft state save failed");
+            }
+            value["draft"] = out.finish();
+        }
+        value["tokens"] = p->bytes(packed.data(), packed.size());
+        value["spec"]   = p->bytes(spec.data(), spec.size());
+        for (const auto & c : prompt.checkpoints) {
+            if (c.n_tokens > int64_t(tokens.size())) {
+                continue;
+            }
+            value["checkpoints"].push_back({
+                { "n_tokens", c.n_tokens },
+                { "pos_min", c.pos_min },
+                { "pos_max", c.pos_max },
+                { "target", p->bytes(c.data_tgt.data(), c.data_tgt.size()) },
+                { "draft", p->bytes(c.data_dft.data(), c.data_dft.size()) },
+                { "spec", p->bytes(c.data_spec.data(), c.data_spec.size()) }
+            });
+        }
+        p->drain();
+        p->space(impl::manifest_bytes(value));
+        sync_dir(p->objects);
+        manifest_write(p->entries / (key + ".json"), value);
+        impl::visit(value, [&](const std::string & h, size_t) { ++p->references[h]; });
+        p->metadata_bytes += impl::manifest_bytes(value);
+        p->index[key] = std::move(value);
+        p->transaction.clear();
+        ++p->saves;
+        while (p->metadata_bytes * 8 > p->metadata_limit() || p->used + p->metadata_bytes > p->options.max_bytes) {
+            if (!p->evict()) {
+                break;
+            }
+        }
+        SRV_INF("persistent save: %zu tokens, %.2f ms, disk %.3f GiB\n", tokens.size(), (stamp() - started) / 1e6,
+                p->used / double(1ull << 30));
+        return true;
+    } catch (const std::exception & e) {
+        SRV_WRN("persistent save skipped: %s\n", e.what());
+        try {
+            p->drain();
+        } catch (...) {
+        }
+        {
+            std::lock_guard<std::mutex> guard(p->mutex);
+            for (const auto & h : p->transaction) {
+                p->verified.erase(h);
+            }
+        }
+        p->transaction.clear();
+        try {
+            p->collect();
+        } catch (const std::exception & failure) {
+            SRV_WRN("persistent cleanup failed: %s\n", failure.what());
+        }
+        {
+            std::lock_guard<std::mutex> guard(p->mutex);
+            p->error.clear();
+        }
+        return false;
+    }
+}
+
+bool server_persistent_cache::load(server_prompt &        prompt,
+                                   const server_tokens &  incoming,
+                                   llama_context *        target,
+                                   llama_context *        draft,
+                                   llama_seq_id           seq,
+                                   std::vector<uint8_t> & spec) {
+    bool   hybrid = llama_model_is_hybrid(llama_get_model(target)) || llama_model_is_recurrent(llama_get_model(target));
+    auto   hashes = prefix_hashes(incoming);
+    size_t best   = reusable(prompt, incoming, hybrid);
+    std::string              selected;
+    uint64_t                 best_bytes = UINT64_MAX;
+    std::vector<std::string> invalid;
+    for (const auto & item : p->index) {
+        const auto & v = item.second;
+        if (v["identity"] != p->options.identity) {
+            continue;
+        }
+        size_t       matched = 0;
+        const auto & old     = v["prefixes"];
+        while (matched < std::min(hashes.size(), old.size()) && hashes[matched] == old[matched].get<std::string>()) {
+            ++matched;
+        }
+        size_t upper = std::min(incoming.size(), v["n_tokens"].get<size_t>());
+        if ((matched + 1) * prefix_step < best || matched == 0) {
+            continue;
+        }
+        upper = std::min(upper, (matched + 1) * prefix_step - 1);
+        if (upper < best) {
+            continue;
+        }
+        try {
+            auto data = p->bytes(v["tokens"], 64u << 20);
+            require(data.size() % sizeof(llama_token) == 0, "invalid packed persistent tokens");
+            llama_tokens words(data.size() / sizeof(llama_token));
+            memcpy(words.data(), data.data(), data.size());
+            server_prompt candidate;
+            candidate.tokens = server_tokens::deserialize(words, incoming.has_mtmd);
+            for (const auto & c : v["checkpoints"]) {
+                common_prompt_checkpoint ck{};
+                ck.n_tokens = c["n_tokens"].get<int64_t>();
+                candidate.checkpoints.push_back(std::move(ck));
+            }
+            size_t   score = reusable(candidate, incoming, hybrid);
+            uint64_t size  = v["target"]["bytes"].get<uint64_t>();
+            if (score > best || (score == best && !selected.empty() && size < best_bytes)) {
+                best       = score;
+                best_bytes = size;
+                selected   = item.first;
+            }
+        } catch (const std::exception & e) {
+            SRV_WRN("persistent lookup rejected: %s\n", e.what());
+            invalid.push_back(item.first);
+        }
+    }
+    for (const auto & id : invalid) {
+        p->remove_entry(id);
+    }
+    p->invalidate_corrupt();
+    if (selected.empty()) {
+        if (best > 0) {
+            ++p->gpu_hits;
+        } else {
+            ++p->misses;
+        }
+        return false;
+    }
+    auto before     = p->read_bytes;
+    auto before_ram = p->ram_read_bytes;
+    auto started    = stamp();
+    try {
+        json &        v = p->index.at(selected);
+        server_prompt restored;
+        prompt.checkpoints.clear();
+        auto         data = p->bytes(v["tokens"], 64u << 20);
+        llama_tokens words(data.size() / sizeof(llama_token));
+        memcpy(words.data(), data.data(), data.size());
+        restored.tokens = server_tokens::deserialize(words, incoming.has_mtmd);
+        for (const auto & c : v["checkpoints"]) {
+            common_prompt_checkpoint ck{};
+            ck.id_task   = -1;
+            ck.n_tokens  = c["n_tokens"].get<int64_t>();
+            ck.pos_min   = c["pos_min"].get<llama_pos>();
+            ck.pos_max   = c["pos_max"].get<llama_pos>();
+            ck.data_tgt  = p->bytes(c["target"], 1ull << 30);
+            ck.data_dft  = p->bytes(c["draft"], 1ull << 30);
+            ck.data_spec = p->bytes(c["spec"], 64u << 20);
+            restored.checkpoints.push_back(std::move(ck));
+        }
+        {
+            impl::reader in(*p, v["target"]);
+            require(llama_state_seq_read_io(target, seq, in) == v["target"]["bytes"].get<size_t>(),
+                    "target persistent restore failed");
+        }
+        if (draft && v["draft"]["bytes"].get<size_t>()) {
+            impl::reader in(*p, v["draft"]);
+            require(llama_state_seq_read_io(draft, seq, in) == v["draft"]["bytes"].get<size_t>(),
+                    "draft persistent restore failed");
+        }
+        spec                  = p->bytes(v["spec"], 64u << 20);
+        prompt                = std::move(restored);
+        size_t previous_bytes = impl::manifest_bytes(v);
+        v["hits"]             = v.value("hits", uint64_t(0)) + 1;
+        v["access"]           = stamp();
+        try {
+            manifest_write(p->entries / (selected + ".json"), v);
+        } catch (const std::exception & e) {
+            SRV_WRN("persistent access update skipped: %s\n", e.what());
+        }
+        p->metadata_bytes += impl::manifest_bytes(v) - previous_bytes;
+        ++p->hits;
+        SRV_INF("persistent hit: reusable=%zu, disk_read=%llu, ram_read=%llu, %.2f ms\n", best,
+                (unsigned long long) (p->read_bytes - before), (unsigned long long) (p->ram_read_bytes - before_ram),
+                (stamp() - started) / 1e6);
+        return true;
+    } catch (const std::exception & e) {
+        SRV_WRN("persistent restore rejected: %s\n", e.what());
+        llama_memory_seq_rm(llama_get_memory(target), seq, -1, -1);
+        if (draft) {
+            llama_memory_seq_rm(llama_get_memory(draft), seq, -1, -1);
+        }
+        prompt.clear();
+        try {
+            p->remove_entry(selected);
+            p->invalidate_corrupt();
+        } catch (const std::exception & failure) {
+            SRV_WRN("persistent cleanup failed: %s\n", failure.what());
+        }
+        ++p->misses;
+        return false;
+    }
+}
+
+json server_persistent_cache::stats() const {
+    std::lock_guard<std::mutex> guard(p->mutex);
+    return {
+#ifdef LLAMA_PERSIST_OPENSSL
+        { "checksum",                   "sha256-openssl"                           },
+#else
+        { "checksum", "sha256-portable" },
+#endif
+        { "entries",                    p->index.size()                            },
+        { "disk_bytes",                 p->used + p->metadata_bytes                },
+        { "metadata_bytes",             p->metadata_bytes                          },
+        { "ram_hot_bytes",              p->hot_bytes                               },
+        { "queued_bytes",               p->queued_bytes                            },
+        { "peak_ram_hot_bytes",         p->peak_hot_bytes                          },
+        { "peak_queued_bytes",          p->peak_queued_bytes                       },
+        { "ram_hot_limit_bytes",        p->options.cache_hot ? p->pool_limit() : 0 },
+        { "queue_limit_bytes",          p->pool_limit()                            },
+        { "tensor_staging_limit_bytes", p->staging_limit()                         },
+        { "ram_budget_bytes",           p->options.ram_bytes                       },
+        { "disk_limit_bytes",           p->options.max_bytes                       },
+        { "saved_bytes",                p->saved_bytes                             },
+        { "deduplicated_bytes",         p->reused_bytes                            },
+        { "verification_read_bytes",    p->verification_read_bytes                 },
+        { "disk_read_bytes",            p->read_bytes                              },
+        { "ram_read_bytes",             p->ram_read_bytes                          },
+        { "saves",                      p->saves                                   },
+        { "hits",                       p->hits                                    },
+        { "gpu_hits",                   p->gpu_hits                                },
+        { "misses",                     p->misses                                  },
+        { "evictions",                  p->evictions                               }
+    };
+}
+
+std::string server_persistent_cache::identity(const common_params & params) {
+    root_prepare(params.cache_dir_path);
+    fs::path root = params.cache_dir_path;
+    int      fd   = open((root / ".identity.lock").c_str(), O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    require(fd >= 0, "cannot open cache identity lock");
+    try {
+        require(flock(fd, LOCK_EX) == 0, "cannot lock cache identity");
+        json memo = json::object();
+        try {
+            auto data = read_file(root / "identities.json", manifest_max);
+            memo      = json::parse(std::string(data.begin(), data.end()));
+        } catch (...) {
+        }
+        auto file_id = [&](const std::string & name) {
+            if (name.empty()) {
+                return std::string();
+            }
+            struct stat st{};
+            require(stat(name.c_str(), &st) == 0, "cannot stat cache identity input");
+            json key = json::array({ st.st_dev, st.st_ino, st.st_size, st.st_mtim.tv_sec, st.st_mtim.tv_nsec,
+                                     st.st_ctim.tv_sec, st.st_ctim.tv_nsec });
+            if (memo.contains(name) && memo[name].value("stat", json()) == key &&
+                digest_ok(memo[name].value("sha256", std::string()))) {
+                return memo[name]["sha256"].get<std::string>();
+            }
+            std::ifstream in(name, std::ios::binary);
+            require(bool(in), "cannot hash cache identity input");
+            cache_hasher               sha;
+            std::vector<unsigned char> buffer(1u << 20);
+            while (in) {
+                in.read(reinterpret_cast<char *>(buffer.data()), buffer.size());
+                sha.update(buffer.data(), size_t(in.gcount()));
+            }
+            require(in.eof(), "cache identity read failed");
+            std::string hex = sha.finish();
+            struct stat after{};
+            require(stat(name.c_str(), &after) == 0 && st.st_size == after.st_size &&
+                        st.st_mtim.tv_sec == after.st_mtim.tv_sec && st.st_mtim.tv_nsec == after.st_mtim.tv_nsec &&
+                        st.st_ctim.tv_sec == after.st_ctim.tv_sec && st.st_ctim.tv_nsec == after.st_ctim.tv_nsec,
+                    "cache identity input changed during hashing");
+            memo[name] = {
+                { "stat",   key },
+                { "sha256", hex }
+            };
+            return hex;
+        };
+        json value = {
+            { "format",     1                                              },
+            { "target",     file_id(params.model.path)                     },
+            { "draft",      file_id(params.speculative.draft.mparams.path) },
+            { "mmproj",     file_id(params.mmproj.path)                    },
+            { "ctx",        params.n_ctx                                   },
+            { "parallel",   params.n_parallel                              },
+            { "ubatch",     params.n_ubatch                                },
+            { "batch",      params.n_batch                                 },
+            { "cache_k",    int(params.cache_type_k)                       },
+            { "cache_v",    int(params.cache_type_v)                       },
+            { "draft_k",    int(params.speculative.draft.cache_type_k)     },
+            { "draft_v",    int(params.speculative.draft.cache_type_v)     },
+            { "image_min",  params.image_min_tokens                        },
+            { "image_max",  params.image_max_tokens                        },
+            { "split_mode", int(params.split_mode)                         },
+            { "rope_base",  params.rope_freq_base                          },
+            { "rope_scale", params.rope_freq_scale                         },
+            { "swa_full",   params.swa_full                                }
+        };
+        value["tensor_split"] = std::vector<float>(params.tensor_split, params.tensor_split + 128);
+        value["rope_type"]    = int(params.rope_scaling_type);
+        value["yarn"]         = json::array({ params.yarn_orig_ctx, params.yarn_ext_factor, params.yarn_attn_factor,
+                                              params.yarn_beta_fast, params.yarn_beta_slow });
+        value["gpu_vision"]   = params.mmproj_use_gpu;
+        value["draft_n_max"]  = params.speculative.draft.n_max;
+        std::vector<std::string> libraries;
+        dl_iterate_phdr(
+            [](dl_phdr_info * info, size_t, void * data) {
+                std::string n = info->dlpi_name;
+                if (n.find("libllama") != std::string::npos || n.find("libggml") != std::string::npos ||
+                    n.find("libmtmd") != std::string::npos) {
+                    static_cast<std::vector<std::string> *>(data)->push_back(n);
+                }
+                return 0;
+            },
+            &libraries);
+        libraries.push_back("/proc/self/exe");
+        std::sort(libraries.begin(), libraries.end());
+        for (const auto & name : libraries) {
+            value["runtime"][fs::path(name).filename().string()] = file_id(name);
+        }
+        std::string data = memo.dump();
+        atomic_file(root / "identities.json", data.data(), data.size());
+        auto result = value.dump();
+        close(fd);
+        return cache_hash(result.data(), result.size());
+    } catch (...) {
+        close(fd);
+        throw;
+    }
+}
