+        ctx->synchronize();
+        return ctx->state_seq_read_data(io, seq_id, LLAMA_STATE_SEQ_FLAGS_NONE);
+    } catch (const std::exception & e) {
+        io.discard();
+        llama_memory_seq_rm(llama_get_memory(ctx), seq_id, -1, -1);
+        LLAMA_LOG_ERROR("%s: %s\n", __func__, e.what());
+        return 0;
+    }
+}
