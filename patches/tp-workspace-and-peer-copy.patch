+static bool ggml_backend_meta_slice_shape(ggml_tensor & tensor, int axis, int64_t local) {
+    const int64_t full = tensor.ne[axis];
+    if (local <= 0 || local > full) {
+        return false;
+    }
+    for (int d = 0; d < GGML_MAX_DIMS; d++) {
+        if (tensor.nb[d] > tensor.nb[axis]) {
+            if (tensor.nb[d] % full != 0) {
+                return false;
+            }
+            tensor.nb[d] = tensor.nb[d] / full * local;
+        }
+    }
+    tensor.ne[axis] = local;
+    return true;
+}
+
+static bool ggml_backend_meta_flash_attn_partition(
+        ggml_backend_buffer_type_t buft, const ggml_tensor * tensor, size_t index,
+        ggml_tensor & local, ggml_tensor (&src)[3]) {
+    if (tensor->op != GGML_OP_FLASH_ATTN_EXT || !tensor->src[0] || !tensor->src[1] || !tensor->src[2]) {
+        return false;
+    }
+    const int64_t heads = tensor->src[1]->ne[2];
+    if (heads <= 0 || tensor->src[2]->ne[2] != heads || tensor->src[0]->ne[2] % heads != 0) {
+        return false;
+    }
+    int64_t local_heads = 0;
+    for (int i = 1; i <= 2; i++) {
+        const ggml_tensor * kv = tensor->src[i];
+        const ggml_tensor * cache = kv->view_src ? kv->view_src : kv;
+        if (!ggml_backend_buffer_is_meta(cache->buffer) || kv->ne[0] <= 0 ||
+                cache->ne[0] % kv->ne[0] != 0 || cache->ne[0] / kv->ne[0] != heads) {
+            return false;
+        }
+        const auto cache_buft = ggml_backend_buffer_get_type(cache->buffer);
+        if (ggml_backend_meta_buft_n_bufts(cache_buft) != ggml_backend_meta_buft_n_bufts(buft) ||
+                ggml_backend_meta_buft_simple_buft(cache_buft, index) != ggml_backend_meta_buft_simple_buft(buft, index)) {
+            return false;
+        }
+        const ggml_tensor * part = ggml_backend_meta_buffer_simple_tensor(cache, index);
+        if (!part || part->ne[0] % kv->ne[0] != 0 || part->ne[1] != cache->ne[1] ||
+                part->ne[2] != cache->ne[2] || part->ne[3] != cache->ne[3]) {
+            return false;
+        }
+        const int64_t count = part->ne[0] / kv->ne[0];
+        if (i == 1) {
+            local_heads = count;
+        } else if (count != local_heads) {
+            return false;
+        }
+    }
+    if (local_heads <= 0 || local_heads > heads) {
+        return false;
+    }
+    local = *tensor;
+    for (int i = 0; i < 3; i++) {
+        src[i] = *tensor->src[i];
+        const int64_t count = i == 0 ? local_heads * (src[i].ne[2] / heads) : local_heads;
+        if (!ggml_backend_meta_slice_shape(src[i], 2, count)) {
+            return false;
+        }
+        local.src[i] = &src[i];
+    }
+    // The attention split contract keeps query and KV head ratios equal.
+    return ggml_backend_meta_slice_shape(local, 1, src[0].ne[2]);
+}
