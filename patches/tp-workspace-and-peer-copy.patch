+const ggml_tensor * ggml_backend_meta_row_slice(const ggml_tensor * tensor, size_t index) {
+    if (!tensor || !ggml_backend_buffer_is_meta(tensor->buffer) || index >= ggml_backend_meta_buffer_n_bufs(tensor->buffer)) {
+        return nullptr;
+    }
+    const auto state = ggml_backend_meta_get_split_state(tensor, false);
+    if (state.axis != GGML_BACKEND_SPLIT_AXIS_0 || state.n_segments != 1 || state.nr[0] != 1) {
+        return nullptr;
+    }
+    return ggml_backend_meta_buffer_simple_tensor(tensor, index);
+}
