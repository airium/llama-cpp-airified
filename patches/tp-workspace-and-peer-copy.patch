+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+static bool ggml_backend_cuda_gather_meta_async(ggml_backend_t backend_src, ggml_backend_t backend_dst, const ggml_tensor * src, ggml_tensor * dst) {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_CUDA_SM75_META_GATHER");
+        return value && std::atoi(value) == 1;
+    }();
+    if (!enabled || !ggml_backend_is_meta(backend_src) || !ggml_backend_is_cuda(backend_dst) ||
+            src->type != GGML_TYPE_F32 || src->ne[0] <= 0 || src->ne[1] <= 0 || src->ne[2] != 1 || src->ne[3] != 1 ||
+            !ggml_is_contiguous(src) || !ggml_is_contiguous(dst) || !ggml_backend_buffer_is_cuda(dst->buffer)) {
+        return false;
+    }
+    auto * dst_ctx = (ggml_backend_cuda_context *) backend_dst->context;
+    if (ggml_cuda_info().devices[dst_ctx->device].cc != GGML_CUDA_CC_TURING) {
+        return false;
+    }
+    if ((uint64_t) src->ne[0] > SIZE_MAX / sizeof(float)) {
+        return false;
+    }
+    const size_t row_bytes = (size_t) src->ne[0] * sizeof(float);
+    if ((uint64_t) src->ne[1] > SIZE_MAX / row_bytes) {
+        return false;
+    }
+    const size_t count = ggml_backend_meta_n_backends(backend_src);
+    if (count != 2) {
+        return false;
+    }
+    const ggml_tensor * parts[2];
+    int64_t columns = 0;
+    for (size_t i = 0; i < count; i++) {
+        auto backend = ggml_backend_meta_simple_backend(backend_src, i);
+        parts[i] = ggml_backend_meta_row_slice(src, i);
+        const auto * part = parts[i];
+        if (backend == backend_dst || !ggml_backend_is_cuda(backend) || !part || !ggml_backend_buffer_is_cuda(part->buffer) ||
+                part->type != src->type || !ggml_is_contiguous(part) || part->ne[0] <= 0 ||
+                part->ne[0] > src->ne[0] - columns || part->ne[1] != src->ne[1] || part->ne[2] != 1 || part->ne[3] != 1) {
+            return false;
+        }
+        const auto * ctx = (ggml_backend_cuda_context *) backend->context;
+        const auto * buf_ctx = (ggml_backend_cuda_buffer_context *) part->buffer->context;
+        if (ctx->device != buf_ctx->device || ggml_cuda_info().devices[ctx->device].cc != GGML_CUDA_CC_TURING) {
+            return false;
+        }
+#ifdef GGML_CUDA_NO_PEER_COPY
+        if (ctx->device != dst_ctx->device) {
+            return false;
+        }
+#endif
+        columns += part->ne[0];
+    }
+    const auto * dst_buf = (ggml_backend_cuda_buffer_context *) dst->buffer->context;
+    if (columns != src->ne[0] || dst_buf->device != dst_ctx->device) {
+        return false;
+    }
+    // Join prior destination work before either source writes its slice.
+    ggml_cuda_set_device(dst_ctx->device);
+    if (!dst_ctx->copy_event) {
+        CUDA_CHECK(cudaEventCreateWithFlags(&dst_ctx->copy_event, cudaEventDisableTiming));
+    }
+    CUDA_CHECK(cudaEventRecord(dst_ctx->copy_event, dst_ctx->stream()));
+    size_t offset = 0;
+    for (size_t i = 0; i < count; i++) {
+        auto * ctx = (ggml_backend_cuda_context *) ggml_backend_meta_simple_backend(backend_src, i)->context;
+        const auto * part = parts[i];
+        const size_t width = ggml_row_size(part->type, part->ne[0]);
+        const int src_physical = ggml_cuda_get_physical_device(ctx->device);
+        const int dst_physical = ggml_cuda_get_physical_device(dst_ctx->device);
+        ggml_cuda_set_device(ctx->device);
+        CUDA_CHECK(cudaStreamWaitEvent(ctx->stream(), dst_ctx->copy_event, 0));
+        if (src_physical == dst_physical) {
+            CUDA_CHECK(cudaMemcpy2DAsync((char *) dst->data + offset, dst->nb[1], part->data, part->nb[1], width, part->ne[1], cudaMemcpyDeviceToDevice, ctx->stream()));
+        } else {
+            cudaMemcpy3DPeerParms copy = {};
+            copy.srcPtr = make_cudaPitchedPtr(part->data, part->nb[1], width, part->ne[1]);
+            copy.dstPtr = make_cudaPitchedPtr((char *) dst->data + offset, dst->nb[1], width, dst->ne[1]);
+            copy.srcDevice = src_physical;
+            copy.dstDevice = dst_physical;
+            copy.extent = make_cudaExtent(width, part->ne[1], 1);
+            CUDA_CHECK(cudaMemcpy3DPeerAsync(&copy, ctx->stream()));
+        }
+        if (!ctx->copy_event) {
+            CUDA_CHECK(cudaEventCreateWithFlags(&ctx->copy_event, cudaEventDisableTiming));
+        }
+        CUDA_CHECK(cudaEventRecord(ctx->copy_event, ctx->stream()));
+        CUDA_CHECK(cudaStreamWaitEvent(dst_ctx->stream(), ctx->copy_event, 0));
+        offset += width;
+    }
+    return true;
+}
+#endif
