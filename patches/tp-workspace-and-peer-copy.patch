+static bool ggml_backend_meta_cpy_tensor_async(ggml_backend_t backend_src, ggml_backend_t backend_dst, const ggml_tensor * src, ggml_tensor * dst) {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_META_ASYNC_BROADCAST");
+        return value && std::atoi(value) == 1;
+    }();
+    if (!enabled || ggml_nelements(src) == 0 || ggml_backend_is_meta(backend_src) || !backend_src->iface.event_wait ||
+            !ggml_backend_buffer_is_meta(dst->buffer) || !ggml_is_contiguous(src)) {
+        return false;
+    }
+    const auto state = ggml_backend_meta_get_split_state(dst, false);
+    if (state.axis != GGML_BACKEND_SPLIT_AXIS_MIRRORED) {
+        return false;
+    }
+    auto * ctx = (ggml_backend_meta_context *) backend_dst->context;
+    for (size_t i = 0; i < ctx->backend_configs.size(); i++) {
+        auto & child = ctx->backend_configs[i];
+        auto * part = ggml_backend_meta_buffer_simple_tensor(dst, i);
+        if (!part || !ggml_are_same_layout(src, part) || !child.backend->iface.cpy_tensor_async ||
+                !child.backend->iface.event_record || !ggml_guid_matches(ggml_backend_guid(backend_src), ggml_backend_guid(child.backend))) {
+            return false;
+        }
+        if (!child.copy_ready) {
+            child.copy_ready.reset(ggml_backend_event_new(ggml_backend_get_device(child.backend)));
+            if (!child.copy_ready) {
+                return false;
+            }
+        }
+    }
+    // Record every destination before enqueuing cross-stream dependencies.
+    for (auto & child : ctx->backend_configs) {
+        ggml_backend_event_record(child.copy_ready.get(), child.backend);
+    }
+    for (size_t i = 0; i < ctx->backend_configs.size(); i++) {
+        auto & child = ctx->backend_configs[i];
+        ggml_backend_event_wait(backend_src, child.copy_ready.get());
+        ggml_backend_tensor_copy_async(backend_src, child.backend, src, ggml_backend_meta_buffer_simple_tensor(dst, i));
+    }
+    return true;
+}
